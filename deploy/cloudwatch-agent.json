{
  "metrics": {
    "namespace": "Synce/Host",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "enabled": true,
        "measurement": ["cpu_usage_idle"],
        "stats": ["avg"]
      },
      "mem": {
        "enabled": true,
        "measurement": ["mem_used_percent"],
        "stats": ["avg"]
      }
    }
  }
}
